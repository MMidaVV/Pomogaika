TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
# Username собственницы в Telegram, без @. Ссылка гостя ведёт в эту личку, не в бота.
TELEGRAM_OWNER_USERNAME=
# Личный WhatsApp для ссылки гостя, без плюса. Тот же номер, что привязан в WhatsApp Web.
WHATSAPP_OWNER_PHONE=
# Личный профиль Max. Профиль → QR → скопировать ссылку. Вид: https://max.ru/u/…
# Гость открывает ваш чат. Фразу «Здравствуйте! Бронь …» Max в адрес не подставляет, она в тексте для копирования.
MAX_OWNER_LINK=
# Через запятую: номера поддержки площадок и свой номер. 8-800 отсекается само.
GUEST_PHONE_BLOCKLIST=
TELEGRAM_CLEANER_USER_ID=
TELEGRAM_WEBAPP_URL=
# false — отключить проверку подписи Telegram, только для локальной разработки
TELEGRAM_AUTH_REQUIRED=true
TOKENROUTER_API_KEY=
TOKENROUTER_MODEL=z-ai/glm-5.3-flash
# true — Помогайка отвечает гостю сама, без кнопки. Деньги, жалобы и коды
# от двери всё равно уходят человеку.
COPILOT_AUTOSEND=false
# Турналог: ставка и минимум за сутки, см. docs/deploy.md
TOURIST_TAX_PERCENT=1.0
TOURIST_TAX_MIN_RUB_PER_NIGHT=100
# Как часто сами тянем календари площадок, минут. 0 — только по кнопке
ICAL_SYNC_MINUTES=30
# Почта площадок (mail.ru: imap.mail.ru). Пароль — для внешних приложений, не основной
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_MINUTES=5
# Ответ гостю письмом (канал Яндекса). Пусто — берём доступы от IMAP.
# SMTP_HOST пусто → выводится из IMAP_HOST: imap.mail.ru → smtp.mail.ru
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# true — Помогайка отвечает гостю письмом сама. Пока false: только черновики.
GUEST_MAIL_AUTOSEND=false
# false — письма с сообщениями гостя не разбираем вовсе (рубильник без выкатки)
GUEST_MAIL_ENABLED=true
# Разбирать только свежие сообщения гостя. Старое непрочитанное письмо — это
# история, а не новый вопрос. 0 — без ограничения по возрасту.
GUEST_MAIL_MAX_AGE_HOURS=48
